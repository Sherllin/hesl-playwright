# 复制为 .env，仅配置专用于本任务的测试环境及六个独立账号。
# 用例会创建学科、题库、项目、任务和题目并保留；不会重置数据库。
BMTK_BASE_URL=
# 可选：运行记录中显示的环境名称，例如 39 测试环境、本地环境。
BMTK_ENV_NAME=
BMTK_TENANT_NAME=
BMTK_ALLOW_WRITES=0
BMTK_ADMIN_USERNAME=
BMTK_ADMIN_PASSWORD=
BMTK_LEADER_USERNAME=
BMTK_LEADER_PASSWORD=
BMTK_AUTHOR_USERNAME=
BMTK_AUTHOR_PASSWORD=
BMTK_QUESTION_REVIEWER_USERNAME=
BMTK_QUESTION_REVIEWER_PASSWORD=
BMTK_COMPOSER_USERNAME=
BMTK_COMPOSER_PASSWORD=
BMTK_PAPER_REVIEWER_USERNAME=
BMTK_PAPER_REVIEWER_PASSWORD=
# 安装了 pypdf>=5,<7 的 Python 可执行文件路径。
BMTK_PDF_PYTHON=python3
